# Copy thành .env rồi điền. KHÔNG commit file .env.
DISCORD_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# User ID của chủ bot (bot gắn nhãn "chủ bot" cho tin của người này)
OWNER_ID=
# Để trống = ai cũng dùng được. Điền danh sách ID, ngăn cách bằng dấu phẩy, để giới hạn.
ALLOWED_USER_IDS=
ALLOWED_CHANNEL_IDS=
HISTORY_TURNS=6
MAX_TOOL_ROUNDS=4
RATE_LIMIT_PER_MIN=5
DATA_DIR=data
# Chọn nhà cung cấp LLM: gemini (mặc định) hoặc anthropic (API kiểu Anthropic/gateway tương thích)
LLM_PROVIDER=gemini
# Chỉ cần khi LLM_PROVIDER=anthropic:
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
